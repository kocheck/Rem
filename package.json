{
  "name": "figma-rem-plugin",
  "version": "1.0.0",
  "description": "A Figma plugin that manages font sizes across designs using a rem-based system",
  "main": "code.js",
  "scripts": {
    "build": "tsc && esbuild ui.ts --bundle --outfile=dist/ui.js",
    "watch": "concurrently \"tsc --watch\" \"esbuild ui.ts --bundle --outfile=dist/ui.js --watch\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "figma",
    "plugin",
    "rem",
    "typography",
    "font-size",
    "design-system"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@figma/plugin-typings": "^1.90.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {}
}
